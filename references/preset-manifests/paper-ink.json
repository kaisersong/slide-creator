{
  "version": 1,
  "preset": "Paper & Ink",
  "support_state": "unified_profile_renderer",
  "renderer_strategy": "unified_profile",
  "source_reference": "references/paper-ink.md",
  "fonts": [
    "crimson pro",
    "georgia",
    "sans-serif",
    "serif",
    "system-ui"
  ],
  "tokens": {
    "css_vars": {
      "--accent": "#000",
      "--bg": "#111",
      "--card-bg": "#1c1917",
      "--card-border": "#999",
      "--divider": "#fefdf8",
      "--duration-normal": "#fff",
      "--ease-out-expo": "rgba(0,0,0,0.50)",
      "--slide-padding": "rgba(0,0,0,0.78)",
      "--text-body": "rgba(0,0,0,0.85)",
      "--text-muted": "rgba(16,185,129,0.80)",
      "--text-primary": "rgba(255,255,255,0.10)",
      "--text-secondary": "#000"
    },
    "colors": [
      "#000",
      "#111",
      "#1c1917",
      "#999",
      "#fefdf8",
      "#fff",
      "rgba(0,0,0,0.50)",
      "rgba(0,0,0,0.78)",
      "rgba(0,0,0,0.85)",
      "rgba(16,185,129,0.80)",
      "rgba(255,255,255,0.10)"
    ]
  },
  "layout_families": [
    "paper_hero",
    "paper_columns",
    "paper_pullquote",
    "paper_index",
    "paper_close"
  ],
  "signature_components": [
    "pill",
    "stats",
    "stat",
    "body-text",
    "drop-cap",
    "pull-quote",
    "stat-row",
    "stat-label",
    "steps",
    "step",
    "cta-layout",
    "editing-layout",
    "hero-layout",
    "install-layout",
    "present-mode-layout",
    "preset-gallery-layout",
    "problem-layout",
    "workflow-layout"
  ],
  "required_visible_components": [
    {
      "name": "pill",
      "selectors": [
        ".pill"
      ],
      "min_count": 1
    },
    {
      "name": "stats",
      "selectors": [
        ".stats"
      ],
      "min_count": 1
    },
    {
      "name": "stat",
      "selectors": [
        ".stat"
      ],
      "min_count": 1
    },
    {
      "name": "body-text",
      "selectors": [
        ".body-text"
      ],
      "min_count": 1
    },
    {
      "name": "drop-cap",
      "selectors": [
        ".drop-cap"
      ],
      "min_count": 1
    },
    {
      "name": "pull-quote",
      "selectors": [
        ".pull-quote"
      ],
      "min_count": 1
    },
    {
      "name": "stat-row",
      "selectors": [
        ".stat-row"
      ],
      "min_count": 1
    },
    {
      "name": "stat-label",
      "selectors": [
        ".stat-label"
      ],
      "min_count": 1
    }
  ],
  "decorative_selectors": [
    ".cta-layout",
    ".editing-layout",
    ".hero-layout",
    ".install-layout",
    ".present-mode-layout",
    ".preset-gallery-layout",
    ".problem-layout",
    ".workflow-layout"
  ],
  "non_critical_selectors": [
    ".slide-num-label",
    ".progress-bar",
    "#presenter-view"
  ],
  "forbidden_substitutions": [
    "generic-theme-shell",
    "marker-only-style-signature",
    "empty-component-shell"
  ]
}
